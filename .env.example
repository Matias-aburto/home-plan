# Copia este archivo como .env para desarrollo local. Todas son opcionales.

# Base de datos Turso. Sin ella se usa data/home-plan.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Tiempo real con Ably. Sin ella los cambios de otros dispositivos se ven al recargar.
ABLY_API_KEY=

# Client ID de la credencial OAuth de Google ("Aplicación web").
GOOGLE_CLIENT_ID=

# 1 habilita entrar solo con un email, sin Google. Nunca se activa en Vercel.
AUTH_DEV_LOGIN=
